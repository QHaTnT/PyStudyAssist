# PyPalPrep 配置文件模板
# 复制此文件为 .env 并根据需要修改

# ==================== 数据库配置 ====================
# SQLite 数据库路径（本地缓存）
SQLITE_PATH=data/database/pypalprep.db

# MySQL 配置（远程数据库，可选）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=pypalprep_cloud

# ==================== AI 助手配置 ====================
# mimo API 配置
MIMO_API_KEY=your_api_key_here

# ==================== 其他配置 ====================
# 默认用户（首次启动时自动创建）
DEFAULT_USERNAME=1
DEFAULT_PASSWORD=1
